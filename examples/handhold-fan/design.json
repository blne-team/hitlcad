    {
      "text": "Small enough to hold in one hand: the whole blower fits in 220 × 100 × 220 mm",
      "check": {
        "kind": "fits_within",
        "box": [
          220,
          100,
          220
        ]
      }
    },
    {
      "text": "Impeller blade tips clear the duct",
      "check": {
        "kind": "clearance",
        "between": [
          "impeller",
          "duct"
        ],
        "min": 0.4
      }
    },
    {
      "text": "Impeller clears the guard",
      "check": {
        "kind": "clearance",
        "between": [
          "impeller",
          "intake_guard"
        ],
        "min": 2
      }
    },
    {
      "text": "Impeller clears the motor mount",
      "check": {
        "kind": "clearance",
        "between": [
          "impeller",
          "motor_mount"
        ],
        "min": 0.5
      }
    },
    {
      "text": "Impeller clears the motor screw heads",
      "check": {
        "kind": "clearance",
        "between": [
          "impeller",
          "motor_screw[0]"
        ],
        "min": 1
      }
    },
    {
      "text": "Impeller is one solid piece",
      "check": {
        "kind": "bodies",
        "count": 1,
        "target": "impeller"
