  "brief": {
    "title": "NEMA 17 planetary gearbox",
    "summary": "A 4:1 single-stage planetary gearbox that bolts onto a NEMA 17 stepper: the sun sits on the motor's D shaft, the ring gear is cut into the housing, three planets turn on the carrier's pins and the carrier's 8 mm output shaft runs in a 608 bearing in the lid. Printed in PLA.",
    "features": [
      "Involute gears, module 1.25, 20° pressure angle",
      "Ring gear cut into the housing",
      "Counterbored NEMA 17 mount with pilot recess",
      "608 bearing pocket in the lid",
      "Heat-set inserts for the lid screws"
    ]
  }
